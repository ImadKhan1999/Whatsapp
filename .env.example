# Copy to .env and adjust. All values are optional.

# Where the WhatsApp login session is stored. Keep this folder private and backed up;
# losing it means scanning the QR again (frequent re-linking looks suspicious).
AUTH_DIR=./auth

# Link with an 8-character pairing code instead of a QR. Your number in international
# format, digits only, e.g. 923001234567. Leave empty to use the QR code.
PAIRING_NUMBER=

# Human-like timing (milliseconds)
READ_DELAY_MIN_MS=1500
READ_DELAY_MAX_MS=4000
TYPING_MS_PER_CHAR=45
TYPING_MIN_MS=1500
TYPING_MAX_MS=7000
MIN_GAP_BETWEEN_SENDS_MS=3000

# Rate limits (outgoing replies)
PER_CHAT_REPLIES_PER_MINUTE=4
PER_CHAT_REPLIES_PER_HOUR=30
GLOBAL_REPLIES_PER_MINUTE=12
GLOBAL_REPLIES_PER_HOUR=300
GLOBAL_REPLIES_PER_DAY=1500

# Incoming flood protection: a chat that sends more than this many messages per minute
# is muted for MUTE_MINUTES (the bot stays silent to them).
INCOMING_FLOOD_PER_MINUTE=10
MUTE_MINUTES=15

# Ignore messages older than this when they arrive (e.g. backlog after being offline).
MAX_MESSAGE_AGE_SECONDS=300

# Only answer the same unrecognised text with the menu once per this many minutes per chat.
FALLBACK_COOLDOWN_MINUTES=10

LOG_LEVEL=info
